---
// Coverage = platforms + games in one act: what it farms (Twitch & Kick cards)
// and the proof (revolving 3D wall of box art). Merges the old Platforms and
// Games sections, which repeated each other's copy.
import { Image } from "astro:assets";
import { LINKS } from "../consts";

// The section's claim is "two platforms, every campaign". Two mirrored cards
// said the opposite — that the platforms are interchangeable — and buried the
// one interesting fact: Twitch and Kick reach the same result by completely
// different machinery. So it renders as one pipeline in two columns. The row
// labels are what never changes; the cells are what each platform does. Copy
// is sourced from the adapters, matching the two landing pages.
const platforms = [
  { key: "twitch", name: "Twitch", href: LINKS.twitchFarmer, link: "How to farm Twitch Drops automatically" },
  { key: "kick", name: "Kick", href: LINKS.kickFarmer, link: "How to farm Kick Drops automatically" },
];

const stages = [
  {
    label: "Finds campaigns",
    twitch: "Cross-checks live campaigns against your inventory, so it never spends hours re-earning a drop you already own.",
    kick: "Subscribes to Kick's realtime campaign channel and picks up a new campaign seconds after it opens.",
  },
  {
    label: "Picks a channel",
    twitch: "Only channels actually enrolled in the campaign — and the ones you already follow when several qualify.",
    kick: "Any channel live in the campaign's category, again leaning on your follows when it's a toss-up.",
  },
  {
    label: "Keeps watching",
    twitch: "Sends the player's own minute-watched signal, so no video tab is open and nothing is decoded.",
    kick: "Holds Kick's viewer session from the background, and falls back to a muted tab if Kick turns it down.",
  },
  {
    label: "Claims rewards",
    twitch: "Every tier the moment it completes, plus channel points on the channel it is farming.",
    kick: "Drops as they complete, plus the daily challenge cards people most often forget.",
  },
];

// Eagerly import every game cover (Twitch box art) so Astro fingerprints +
// optimizes them.
const covers = import.meta.glob<{ default: ImageMetadata }>("../assets/games/*.jpg", { eager: true });

const NAMES: Record<string, string> = {
  rust: "Rust",
  valorant: "Valorant",
  "apex-legends": "Apex Legends",
  "dota-2": "Dota 2",
  "counter-strike": "Counter-Strike 2",
  "escape-from-tarkov": "Escape from Tarkov",
  "rainbow-six-siege": "Rainbow Six Siege",
  "dead-by-daylight": "Dead by Daylight",
  warframe: "Warframe",
  "league-of-legends": "League of Legends",
  "new-world": "New World",
  "destiny-2": "Destiny 2",
  "sea-of-thieves": "Sea of Thieves",
  "halo-infinite": "Halo Infinite",
  "diablo-iv": "Diablo IV",
  pubg: "PUBG",
  "war-thunder": "War Thunder",
};

type Game = { name: string; img: ImageMetadata };
const games: Game[] = Object.entries(covers)
  .map(([path, mod]) => {
    const slug = path.split("/").pop()!.replace(".jpg", "");
    return { name: NAMES[slug] ?? slug, img: mod.default };
  })
  .sort((a, b) => a.name.localeCompare(b.name));

// Split into two rows that scroll in opposite directions. Each row is doubled
// so the CSS marquee loops seamlessly. (Mobile / reduced-motion fallback — on
// desktop the covers form a revolving 3D carousel instead.)
const mid = Math.ceil(games.length / 2);
const rowA: Game[] = games.slice(0, mid);
const rowB: Game[] = games.slice(mid);
const loopA = [...rowA, ...rowA];
const loopB = [...rowB, ...rowB];

// 3D ring geometry: place every cover on a cylinder. Radius derives from the
// card width + breathing room so neighbours never overlap.
const RING_STEP = 360 / games.length;
const RING_RADIUS = Math.round((games.length * 196) / (2 * Math.PI));
---

<section id="coverage" class="cov act">
  <div class="wrap">
    <div class="cov__head">
      <p class="eyebrow reveal">Coverage</p>
      <h2 class="reveal-slow">Two platforms.<br />Every drop campaign.</h2>
      <p class="reveal">Wherever a campaign runs, it's already on it — watching a channel that actually counts toward your drop. The two platforms get there differently.</p>
    </div>

    <table class="cov__matrix reveal">
      <thead>
        <tr>
          <th scope="col"></th>
          {platforms.map((p) => (
            <th scope="col" class={`cov__col cov__col--${p.key}`}>{p.name}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {stages.map((stage) => (
          <tr>
            <th scope="row">{stage.label}</th>
            <td data-platform="Twitch">{stage.twitch}</td>
            <td data-platform="Kick">{stage.kick}</td>
          </tr>
        ))}
      </tbody>
      <tfoot>
        <tr>
          <td class="cov__foot-spacer"></td>
          {platforms.map((p) => (
            <td class={`cov__foot cov__foot--${p.key}`}>
              <a href={p.href}>{p.link}</a>
            </td>
          ))}
        </tr>
      </tfoot>
    </table>
  </div>

  <div class="wrap">
    <p class="cov__games-lede reveal">
      <span class="grad-text">Any game, any campaign.</span> If a drop exists,
      it gets farmed the moment it goes live — these are just a few of them.
    </p>
  </div>

  <!-- Desktop: a revolving 3D carousel of box art. -->
  <div class="ring-scene" style={`--ring-r:${RING_RADIUS}px`}>
    <div class="ring-tilt">
      <div class="ring3d">
        {games.map((g, i) => (
          <figure class="gcard gcard--ring" style={`--ra:${(i * RING_STEP).toFixed(2)}deg`}>
            <Image src={g.img} alt={`${g.name} — Twitch drops supported`} widths={[180, 320]} sizes="180px" loading="lazy" />
            <figcaption>{g.name}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>

  <div class="marq">
    <div class="marq__track">
      {loopA.map((g) => (
        <figure class="gcard">
          <Image src={g.img} alt={`${g.name} — Twitch drops supported`} widths={[150, 260]} sizes="150px" loading="lazy" />
          <figcaption>{g.name}</figcaption>
        </figure>
      ))}
    </div>
  </div>
  <div class="marq marq--rev">
    <div class="marq__track">
      {loopB.map((g) => (
        <figure class="gcard">
          <Image src={g.img} alt={`${g.name} — Twitch drops supported`} widths={[150, 260]} sizes="150px" loading="lazy" />
          <figcaption>{g.name}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .cov {
    overflow: hidden;
  }
  .cov__head h2 {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.98;
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    margin: 0.6rem 0 1rem;
  }
  .cov__head > p:last-child {
    color: var(--muted);
    font-size: 1.1rem;
    max-width: 52ch;
  }
  .cov__head b { color: var(--text); font-weight: 600; }

  /* ---------- platform comparison ---------- */
  /* A real table: this is 2 platforms x 4 stages of genuinely tabular data, and
     the row/column headers are what makes it readable to a screen reader and
     worth indexing. Hairline rules only — no cell borders, no card chrome. */
  .cov__matrix {
    --tw: var(--purple-soft);
    --kk: var(--lime);
    width: 100%;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    border-collapse: collapse;
    text-align: left;
  }
  .cov__matrix th,
  .cov__matrix td {
    vertical-align: top;
    padding: 1.5rem 1.6rem;
  }
  /* One hairline across the full width anchors the header row, matching the
     rules between body rows. An accent rule per column was tried and removed:
     the two segments met with no gap, so they read as a single line that
     changed colour for no reason, and at 2px they fought the 1px rules below. */
  .cov__matrix thead tr { border-top: 1px solid var(--line-strong); }
  .cov__matrix thead th {
    padding-top: 1.3rem;
    padding-bottom: 1.1rem;
  }
  /* The platform name carries its own colour instead — the same coding the
     stacked mobile layout uses, and it lands on the word it identifies. */
  .cov__col {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.3rem, 2.2vw, 1.75rem);
    letter-spacing: -0.025em;
    color: var(--c);
    width: 38%;
  }
  .cov__col--twitch { --c: var(--tw); }
  .cov__col--kick { --c: var(--kk); }
  .cov__matrix tbody tr { border-top: 1px solid var(--line); }
  .cov__matrix tbody th {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--text);
    padding-left: 0;
    width: 24%;
  }
  .cov__matrix tbody td {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.65;
  }
  /* Tinting the whole column on hover keeps the two readable as units without
     giving each cell its own hover state. */
  @media (hover: hover) and (min-width: 760px) {
    .cov__matrix tbody td { transition: background 0.3s var(--ease), color 0.3s var(--ease); }
    .cov__matrix:has(tbody td:nth-child(2):hover) tbody td:nth-child(2),
    .cov__matrix:has(tfoot .cov__foot--twitch:hover) tbody td:nth-child(2) {
      background: rgba(145, 71, 255, 0.07);
      color: var(--text);
    }
    .cov__matrix:has(tbody td:nth-child(3):hover) tbody td:nth-child(3),
    .cov__matrix:has(tfoot .cov__foot--kick:hover) tbody td:nth-child(3) {
      background: rgba(83, 252, 24, 0.06);
      color: var(--text);
    }
  }
  /* The rule runs the table's full width like every other one; a rule that
     began at the first column read as an accident rather than a choice. */
  .cov__matrix tfoot tr { border-top: 1px solid var(--line); }
  .cov__matrix tfoot td { padding-bottom: 0; }
  .cov__foot--twitch { --c: var(--tw); }
  .cov__foot--kick { --c: var(--kk); }
  .cov__foot a {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--c);
    border-bottom: 1px solid color-mix(in oklch, var(--c) 35%, transparent);
    padding-bottom: 2px;
    transition: border-color 0.25s var(--ease);
  }
  .cov__foot a:hover { border-bottom-color: var(--c); }

  /* Below the two-column threshold the table restacks by row: each stage keeps
     its label, then names each platform before its answer, so the comparison
     survives instead of becoming two disconnected lists. */
  @media (max-width: 759px) {
    .cov__matrix,
    .cov__matrix tbody,
    .cov__matrix tfoot,
    .cov__matrix tr,
    .cov__matrix td {
      display: block;
    }
    .cov__matrix thead { display: none; }
    .cov__matrix tbody th {
      display: block;
      width: auto;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.2rem;
      letter-spacing: -0.02em;
      padding: 1.6rem 0 0.9rem;
    }
    .cov__matrix tbody td {
      padding: 0 0 1rem;
      position: relative;
      padding-left: 1.1rem;
    }
    .cov__matrix tbody td::before {
      content: attr(data-platform);
      display: block;
      font-weight: 600;
      font-size: 0.85rem;
      color: var(--c);
      margin-bottom: 0.25rem;
    }
    .cov__matrix tbody td[data-platform="Twitch"] { --c: var(--tw); }
    .cov__matrix tbody td[data-platform="Kick"] { --c: var(--kk); }
    .cov__matrix tbody td::after {
      content: "";
      position: absolute;
      left: 0;
      top: 0.3em;
      bottom: 1.4rem;
      width: 2px;
      border-radius: 2px;
      background: var(--c);
      opacity: 0.55;
    }
    .cov__foot-spacer { display: none; }
    /* Qualified with tfoot: bare .cov__foot (0,1,0) loses to the shared
       `.cov__matrix td` padding rule (0,1,1) and the links keep an indent the
       stage headings above them do not have. */
    .cov__matrix tfoot td { padding: 1.2rem 0 0; }
  }

  /* ---------- games lede ---------- */
  .cov__games-lede {
    text-align: center;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.2rem, 2.4vw, 1.7rem);
    letter-spacing: -0.02em;
    max-width: 44ch;
    margin: clamp(4rem, 9vw, 6.5rem) auto clamp(1.5rem, 3vw, 2.5rem);
  }

  /* ---------- 3D ring carousel (desktop, motion-friendly only) ---------- */
  .ring-scene {
    display: none;
  }
  @media (min-width: 900px) and (prefers-reduced-motion: no-preference) {
    .marq {
      display: none;
    }
    .ring-scene {
      display: block;
      perspective: 1800px;
      /* tall enough that the nearest cards — scaled up by perspective AND
         pushed down ~85px by the rotateX tilt — aren't masked off */
      height: 580px;
      margin-top: -2rem;
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
      mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
    }
    .ring-tilt {
      height: 100%;
      transform-style: preserve-3d;
      transform: rotateX(-9deg);
    }
    .ring3d {
      position: relative;
      height: 100%;
      transform-style: preserve-3d;
      animation: ring-spin 75s linear infinite;
    }
    .ring-scene:hover .ring3d {
      animation-play-state: paused;
    }
    @keyframes ring-spin {
      to {
        transform: rotateY(-360deg);
      }
    }
    /* .gcard.gcard--ring outranks the base .gcard rules further down */
    .gcard.gcard--ring {
      position: absolute;
      left: calc(50% - 85px);
      /* biased above center: the tilt drops the near (largest) cards lower */
      top: calc(50% - 145px);
      width: 170px;
      height: 226px;
      transform: rotateY(var(--ra)) translateZ(var(--ring-r));
      backface-visibility: hidden;
      transition: border-color 0.35s var(--ease), box-shadow 0.35s var(--ease);
    }
    /* placement transform is load-bearing — pop with light, not movement */
    .gcard.gcard--ring:hover {
      transform: rotateY(var(--ra)) translateZ(var(--ring-r));
      border-color: var(--purple);
      box-shadow: 0 30px 60px -28px var(--glow-purple);
    }
  }

  /* ---------- marquee fallback ---------- */
  .marq {
    overflow: hidden;
    padding: 0.6rem 0;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .marq__track {
    display: flex;
    gap: 1rem;
    width: max-content;
    animation: scroll-l 58s linear infinite;
  }
  .marq--rev .marq__track {
    animation-direction: reverse;
    animation-duration: 66s;
  }
  .marq:hover .marq__track {
    animation-play-state: paused;
  }
  @keyframes scroll-l {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marq__track {
      animation: none;
    }
  }

  .gcard {
    position: relative;
    flex: 0 0 auto;
    width: clamp(116px, 13vw, 150px);
    aspect-ratio: 3 / 4;
    margin: 0;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--ink-2);
    box-shadow: 0 18px 40px -24px rgba(0, 0, 0, 0.9);
    transition: transform 0.35s var(--ease), border-color 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }
  .gcard :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(1.05) contrast(1.02);
    transition: transform 0.5s var(--ease);
  }
  .gcard::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, rgba(6, 6, 9, 0.92));
    opacity: 0.85;
    transition: opacity 0.35s var(--ease);
  }
  .gcard figcaption {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 1;
    padding: 0.7rem 0.7rem 0.6rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.82rem;
    letter-spacing: -0.01em;
    line-height: 1.1;
    color: #fff;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.7);
  }
  .gcard:hover {
    transform: translateY(-8px) scale(1.04);
    border-color: var(--purple);
    box-shadow: 0 30px 60px -28px var(--glow-purple);
  }
  .gcard:hover :global(img) {
    transform: scale(1.08);
  }
  .gcard:hover::after {
    opacity: 1;
  }
</style>
