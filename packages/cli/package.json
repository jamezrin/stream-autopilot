{
  "name": "@lurkloot/cli",
  "version": "1.12.2",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "bin": {
    "lurkloot": "./dist/index.mjs"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --main-fields=module,main --outfile=dist/index.mjs --external:cycletls",
    "cli": "pnpm build && node dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lurkloot/core": "workspace:*",
    "@lurkloot/shared": "workspace:*",
    "cycletls": "^2.0.5",
    "jsonc-parser": "^3.3.1",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/yargs": "^17.0.33",
    "esbuild": "^0.28.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
