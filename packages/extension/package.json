{
  "name": "@lurkloot/extension",
  "version": "1.12.2",
  "description": "Cross-browser Twitch and Kick drops farming WebExtension using visible muted tabs.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "kick:inspect": "node scripts/kick-inspect.mjs",
    "screenshot:store": "pnpm build && node scripts/capture-store-screenshot.mjs",
    "screenshot:store:upload": "node scripts/upload-store-screenshots.mjs",
    "screenshot:store:sync": "pnpm screenshot:store && pnpm screenshot:store:upload",
    "promo:store": "pnpm build && node scripts/capture-store-promo.mjs"
  },
  "dependencies": {
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@lurkloot/core": "workspace:*",
    "@lurkloot/locales": "workspace:*",
    "@lurkloot/popup-ui": "workspace:*",
    "@lurkloot/shared": "workspace:*",
    "@vitejs/plugin-react": "^6.0.0",
    "@wxt-dev/module-react": "^1.1.3",
    "lucide-react": "^1.0.0",
    "motion": "^13.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "wxt": "^0.21.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/chrome": "^0.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "fake-indexeddb": "^6.2.5",
    "linkedom": "0.18.13",
    "playwright": "^1.61.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.0",
    "vite": "^8.1.5",
    "vitest": "^5.0.0"
  }
}
